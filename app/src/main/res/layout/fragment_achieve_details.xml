<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/storyShow"
    android:visibility="invisible"
    tools:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/storyConstraint"
        android:layout_width="match_parent"
        android:background="@drawable/bg_rarity_exclusive"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="16dp"
            style="?android:attr/progressBarStyleHorizontal"

            android:progressDrawable="@drawable/progress_exclusive"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/storyImageCard"
            android:layout_width="180dp"
            android:layout_height="180dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="0.4">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/storyImage"
                android:src="@drawable/img" />

        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:id="@+id/storyAchieveTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/storyImageCard"
            android:layout_marginHorizontal="60dp"
            android:layout_marginVertical="20dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:textSize="22sp"
            tools:text="Авторитетный Автор" />


        <TextView
            android:id="@+id/storyAchieveDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/storyAchieveTitle"
            app:layout_constraintStart_toStartOf="@id/storyAchieveTitle"
            app:layout_constraintEnd_toEndOf="@id/storyAchieveTitle"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginHorizontal="60dp"
            android:layout_marginVertical="10dp"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:textSize="16sp"
            tools:text="Напиши и опубликуй три успешные статьи на платформе MakalaBox." />


    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>